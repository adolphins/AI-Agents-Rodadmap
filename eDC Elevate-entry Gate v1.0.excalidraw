      "text": "eDc平台必要性论证（整合版）",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "eDc平台必要性论证（整合版）",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VPC46iiYk7LI36iAyDe04",
      "type": "text",
      "x": 6478.988460424525,
      "y": 2221.9587684499816,
      "width": 1159.9154751287024,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCu",
      "roundness": null,
      "seed": 1706853872,
      "version": 436,
      "versionNonce": 1326171920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790056557989,
      "created": 1790056277886,
      "link": null,
      "locked": false,
      "text": "1. Master data golden record & integrity — 实体级单一可信源，依赖已落地的Reltio Golden ID + 内部业务主键1:1同步机制",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Master data golden record & integrity — 实体级单一可信源，依赖已落地的Reltio Golden ID + 内部业务主键1:1同步机制",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YDNekqCCzJ5Y4GlpUfWes",
      "type": "text",
      "x": 6475.833249277795,
      "y": 2298.1606409746305,
      "width": 1159.1909192551761,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCv",
      "roundness": null,
      "seed": 1185616144,
      "version": 448,
