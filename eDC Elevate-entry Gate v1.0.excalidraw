      "isDeleted": false,
      "boundElements": null,
      "updated": 1790056557989,
      "created": 1790056277887,
      "link": null,
      "locked": false,
      "text": "2. Single source of truth for metric definitions — 指标口径单一可信源，语义层指标字典必须建在已完成跨域治理的eDc之上",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Single source of truth for metric definitions — 指标口径单一可信源，语义层指标字典必须建在已完成跨域治理的eDc之上",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IzhDvymPdEV4fj9EcNzvM",
      "type": "text",
      "x": 6475.833249277795,
      "y": 2374.3625134992794,
      "width": 1258.8750309312368,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
