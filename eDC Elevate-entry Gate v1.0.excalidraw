    {
      "id": "1f9EBh7SEdGZTarHNj8vG",
      "type": "text",
      "x": 1833.5543764983433,
      "y": 1650.7630823763475,
      "width": 530.179931640625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
