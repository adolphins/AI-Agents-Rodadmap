    {
      "id": "pK1pzUnsLE48HAP-_i4bF",
      "type": "text",
      "x": 2442.6208566724185,
      "y": 1504.684069413847,
      "width": 524.8598022460938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#b2f2bb",
