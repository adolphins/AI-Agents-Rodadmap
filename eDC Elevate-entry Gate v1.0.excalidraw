      "isDeleted": false,
      "boundElements": [],
      "updated": 1789969192688,
      "created": 1789882225410,
      "link": null,
      "locked": false,
      "text": "DataR Uploader & 离线工具 上传管数据到 Redshift 和 \n业务自留地等，缺乏 快速数据校验 和 Audit 审计能力。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DataR Uploader & 离线工具 上传管数据到 Redshift 和 \n业务自留地等，缺乏 快速数据校验 和 Audit 审计能力。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VYEgIorsETq5WUjGqPT2_",
      "type": "text",
      "x": 2442.6208566724185,
      "y": 1655.5296323870066,
      "width": 521.0198974609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5K",
