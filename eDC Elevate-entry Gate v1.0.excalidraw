      "frameId": null,
      "index": "b59",
      "roundness": null,
      "seed": 994042213,
      "version": 2457,
      "versionNonce": 1031539064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789969192688,
      "created": 1789881470310,
      "link": null,
      "locked": false,
      "text": "1. 拓展主数据的覆盖范围，需要新增约 30W+ 药店主数据；\n2. 新增更灵活的弱监管入湖路径；\n3. 入湖后利用工具分析 Quick Insight，业务用户可批量\n探查和验证，最后合并到现有主数据。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 拓展主数据的覆盖范围，需要新增约 30W+ 药店主数据；\n2. 新增更灵活的弱监管入湖路径；\n3. 入湖后利用工具分析 Quick Insight，业务用户可批量\n探查和验证，最后合并到现有主数据。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
